{
  "manifest_version": 3,
  "name": "FANZAファイル名指定DL",
  "version": "1.1.0",
  "description": "FANZAの購入済み作品ダウンロードにサークル名・作品名からファイル名を付けます",
  "permissions": ["downloads", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.dmm.co.jp/dc/-/mylibrary/detail/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.dmm.co.jp/dc/doujin/*"],
      "js": ["config.js", "purchased.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FANZAファイル名指定DL の設定"
  }
}
